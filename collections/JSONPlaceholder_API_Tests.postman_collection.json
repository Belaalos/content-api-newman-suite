{
  "info": {
    "name": "JSONPlaceholder API Tests",
    "description": "Functional API tests for https://jsonplaceholder.typicode.com: reads, writes, negative cases, schema validation and request chaining.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts - read",
      "item": [
        {
          "name": "GET all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const posts = pm.response.json();",
                  "pm.test(\"Returns an array of 100 posts\", function () {",
                  "    pm.expect(posts).to.be.an(\"array\").with.lengthOf(100);",
                  "});",
                  "pm.test(\"Every post has userId, id, title and body\", function () {",
                  "    posts.forEach(function (p) {",
                  "        pm.expect(p).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");",
                  "    });",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            }
          }
        },
        {
          "name": "GET single post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const post = pm.response.json();",
                  "pm.test(\"Post id is 1\", function () { pm.expect(post.id).to.eql(1); });",
                  "pm.test(\"Title is a non-empty string\", function () {",
                  "    pm.expect(post.title).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"Response matches the post schema\", function () {",
                  "    const schema = {",
                  "        type: \"object\",",
                  "        required: [\"userId\", \"id\", \"title\", \"body\"],",
                  "        properties: {",
                  "            userId: { type: \"integer\" },",
                  "            id: { type: \"integer\" },",
                  "            title: { type: \"string\" },",
                  "            body: { type: \"string\" }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          }
        },
        {
          "name": "GET posts filtered by userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const posts = pm.response.json();",
                  "pm.test(\"Returns 10 posts\", function () { pm.expect(posts).to.have.lengthOf(10); });",
                  "pm.test(\"All posts belong to user 1\", function () {",
                  "    posts.forEach(function (p) { pm.expect(p.userId).to.eql(1); });",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts?userId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "GET comments of a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const comments = pm.response.json();",
                  "pm.test(\"Returns 5 comments\", function () { pm.expect(comments).to.have.lengthOf(5); });",
                  "pm.test(\"Every comment belongs to post 1 and has an email\", function () {",
                  "    comments.forEach(function (c) {",
                  "        pm.expect(c.postId).to.eql(1);",
                  "        pm.expect(c.email).to.include(\"@\");",
                  "    });",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1/comments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1",
                "comments"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Posts - create, update, delete",
      "item": [
        {
          "name": "POST create a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () { pm.response.to.have.status(201); });",
                  "const created = pm.response.json();",
                  "pm.test(\"Response echoes the request data\", function () {",
                  "    pm.expect(created.title).to.eql(\"QA automation post\");",
                  "    pm.expect(created.body).to.eql(\"Created by a Newman test\");",
                  "    pm.expect(created.userId).to.eql(1);",
                  "});",
                  "pm.test(\"Server assigned a numeric id\", function () {",
                  "    pm.expect(created.id).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA automation post\",\n  \"body\": \"Created by a Newman test\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "PUT replace a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const updated = pm.response.json();",
                  "pm.test(\"Post was fully replaced\", function () {",
                  "    pm.expect(updated.id).to.eql(1);",
                  "    pm.expect(updated.title).to.eql(\"Updated title\");",
                  "    pm.expect(updated.body).to.eql(\"Updated body\");",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated title\",\n  \"body\": \"Updated body\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
