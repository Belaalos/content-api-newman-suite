    {
      "name": "Chained flow",
      "item": [
        {
          "name": "Step 1 - get a post and save its author id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const post = pm.response.json();",
                  "pm.collectionVariables.set(\"authorId\", post.userId);",
                  "pm.test(\"Author id was saved to a variable\", function () {",
                  "    pm.expect(pm.collectionVariables.get(\"authorId\")).to.exist;",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts",
                "5"
              ]
            }
          }
        },
        {
          "name": "Step 2 - get the author of that post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const user = pm.response.json();",
                  "pm.test(\"User id matches the saved author id\", function () {",
                  "    pm.expect(String(user.id)).to.eql(String(pm.collectionVariables.get(\"authorId\")));",
                  "});",
                  "pm.test(\"User has a name and a valid email\", function () {",
                  "    pm.expect(user.name).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(user.email).to.match(/^[^@\\s]+@[^@\\s]+$/);",
                  "});",
                  "pm.test(\"Response time is under 3000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{authorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{authorId}}"
              ]
            }
          }
        }
      ]
    }
